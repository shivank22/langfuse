# =============================================================================
# Central Langfuse — defaults for docker-compose.build.yml
# Copy to .env:  cp .env.example .env
# Docs: docs/operations/deploy.md
#
# Credentials below are fixed random values for local/shared-dev bootstrap.
# Rotate them before exposing a real production host.
# =============================================================================

# --- Public URL (browser + NextAuth) ---
NEXTAUTH_URL=http://localhost:3000

# --- App secrets ---
NEXTAUTH_SECRET=lagBJXXK7zqHEQMoRJOtwDqQHuFfdl
SALT=Fe733oY3f56BKFtUkBMG7uNCXwTeTa
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=d76a095f921475e2254d305eaf3ebe34b9f873baacacea7fd07b419aab84726f

# --- Postgres ---
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=0f9639ffefcd6d84f50876eb1aaecd21
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:0f9639ffefcd6d84f50876eb1aaecd21@postgres:5432/postgres

# --- ClickHouse ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=6a3cd9d4008a3dc1073fc7ab3eb539f6
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=c09dbedb30821aa6f996f2bc6c08972b
REDIS_TLS_ENABLED=false

# --- MinIO / S3-compatible storage ---
# Access key = MINIO_ROOT_USER, secret key = MINIO_ROOT_PASSWORD
# LANGFUSE_S3_* keys must match those two values.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=901d3260b8f5310ebf830320
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=901d3260b8f5310ebf830320
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

# --- Headless init (org, project, API keys, admin user on first boot) ---
# UI login: email + password below. Username displayed as "admin".
LANGFUSE_INIT_ORG_ID=org-central
LANGFUSE_INIT_ORG_NAME=Central
LANGFUSE_INIT_PROJECT_ID=proj-shared
LANGFUSE_INIT_PROJECT_NAME=Shared
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-4a2c319df9fd1fec489d749f
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-166625364921565b786e34b3
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=e0e8a83af25fc3c29f4763b8

# --- Product flags ---
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# --- OpenAI (AI resource) ---
# Not required to start Langfuse.
# App teams set OPENAI_API_KEY in their own services.
# For LLM-as-a-Judge, add an OpenAI connection in the Langfuse UI after boot.
# OPENAI_API_KEY=sk-...

# Build arg (leave empty for self-hosted OSS builds)
NEXT_PUBLIC_LANGFUSE_CLOUD_REGION=
